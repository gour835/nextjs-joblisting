// use prisma-8
// Contract inferred from the live database schema. Edit as needed, 
// then run 
// `prisma contract emit`  
// `prisma db update` (for prisma 8)  

// experiance details:
// {
// companyName:
// skills:
// months:
// compensations: optional
// }

// Resume details:
// {
// name:
// email:
// mobile:
// number: 
// address:
// objectives:
// education:
// ExperianceDetails: will try to fetch from experiance details column if it filled 
// resumeLink: pdf, word files only. prompt user to store the drive link if not upload the file. (will setup upload logic later )
// }

enum JobListingsType {
  @@type("pg/text@1")
  Internship = "INTERNSHIP"
  FullTime = "FULL-TIME"
  PartTime = "PART-TIME"
  WorkFromHome = "WORK-FROM-HOME"
  Remote = "REMOTE"
  Hybrid = "HYBRID"
}

namespace public {
  model User {
    id             Uuid                   @id(map: "user_pkey") @default(sql`gen_random_uuid()`)
    email          String                 @unique(map: "user_email_key")
    username       String?
    password       String
    category       String?
    companyWebsite String?
    image          String?
    createdAt      DateTime(precision: 6) @default(now()) @map("created_at")
    updatedAt      DateTime(precision: 6) @default(now()) @map("updated_at")

    @@map("user")
  }

  model CandidateDetails {
    id                Uuid     @id(map: "candidatedetials_pkey") @default(sql`gen_random_uuid()`)
    userId            Uuid
    user              User     @relation(fields: [userId], references: [id])
    description       String
    skills            String[]
    experianceInYears Int?
    experianceDetails Json
    resume            Json
  }

  model RecruiterDetails {
    id              Uuid     @id(map: "recruiterdetiils_pkey") @default(sql`gen_random_uuid()`)
    userId          Uuid 
    description     String
    location        String[]
    jobsListed      Int?
    candidatesHired Int?
  }

  model Jobs {
    id          Uuid                   @id(map: "jobs_pkey") @default(sql`gen_random_uuid()`)
    title       String                 @unique(map: "jobs_title_key")
    jobListings JobListings[]
    createdAt   DateTime(precision: 6) @default(now()) @map("created_at")
    updatedAt   DateTime(precision: 6) @default(now()) @map("updated_at")
  }

  model Tags {
    id          Uuid                @id(map: "tags_pkey") @default(sql`gen_random_uuid()`)
    title       String              @unique(map: "tags_title_key")
    jobListings TagsOnJobListings[]
  }

  model JobListings {
    id          Uuid                      @id(map: "joblisting_pkey") @default(sql`gen_random_uuid()`)
    jobId       Uuid                      @map("job_id")
    job         Jobs                      @relation(fields: [jobId], references: [id])
    description String
    type        JobListingsType           @default(FullTime)
    location    String?
    payment     Int
    currency    String
    tags        TagsOnJobListings[]
    categories  CategoriesOnJobListings[]
    createdAt   DateTime(precision: 6)    @default(now()) @map("created_at")
    updatedAt   DateTime(precision: 6)    @default(now()) @map("updated_at")
  }

  model Category {
    id          Uuid                      @id(map: "category_pkey") @default(sql`gen_random_uuid()`)
    name        String                    @unique(map: "category_name_key")
    jobListings CategoriesOnJobListings[]
    createdAt   DateTime(precision: 6)    @default(now()) @map("created_at")
    updatedAt   DateTime(precision: 6)    @default(now()) @map("updated_at")
  }

  model TagsOnJobListings {
    jobListingId Uuid
    jobListing   JobListings @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
    tagId        Uuid
    tag          Tags        @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([jobListingId, tagId])
  }

  model CategoriesOnJobListings {
    categoryId    Uuid
    category      Category    @relation(fields: [categoryId], references: [id])
    jobListingsId Uuid
    jobListings   JobListings @relation(fields: [jobListingsId], references: [id])

    @@id([categoryId, jobListingsId])
  }
}
